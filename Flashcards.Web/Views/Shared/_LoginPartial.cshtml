@inject SignInManager<IdentityUser> signInManager

<ul class="navbar-nav ms-auto">
    @if (signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a asp-area="Account" asp-controller="Account" asp-action="Logout" class="nav-link text-light">Logout</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a asp-area="Account" asp-controller="Account" asp-action="Login" class="nav-link text-light">Login</a>
        </li>

        <li class="nav-item">
            <a asp-area="Account" asp-controller="Account" asp-action="Register" class="nav-link text-light">Register</a>
        </li>
    }
</ul>