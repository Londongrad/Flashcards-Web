@inject SignInManager<IdentityUser> signInManager

<ul class="navbar-nav ms-auto">
    @if (signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <form method="post" asp-area="Account" asp-controller="Account" asp-action="Logout">
                <button asp-area="Account" asp-controller="Account" asp-action="Logout" type="submit" class="nav-link text-light">
                    Logout @User.Identity!.Name
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a asp-area="Account" asp-controller="Account" asp-action="Login" class="nav-link text-light">Login</a>
        </li>

        <li class="nav-item">
            <a asp-area="Account" asp-controller="Account" asp-action="Register" class="nav-link text-light">Register</a>
        </li>
    }
</ul>