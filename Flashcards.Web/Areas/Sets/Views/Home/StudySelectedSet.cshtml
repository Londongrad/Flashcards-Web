<div class="quizlet-layout">
    <div class="quizlet-nav-btns-wrapper">
        <button id="BtnPrev" class="quizlet-nav-btn btn-prev">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <div id="card" class="quizlet-flip-container" onclick="flipCard(this)">

        <div class="quizlet-top-buttons">
            <a id="BtnSound" class="btn sound-fav-btn" title="Play sound">
                <i class="bi bi-volume-up-fill"></i>
            </a>

            <a id="BtnFav" class="btn sound-fav-btn" title="Favorite"
               style="background-color: @(!Model.CurrentWord.IsFavorite ? "transparent" : "yellow")">
                <i class="bi bi-star-fill"></i>
            </a>
        </div>

        <div class="quizlet-flipper">
            <div class="quizlet-front">
                <p id="wordName" class="quizlet-word">@Model.CurrentWord.Name</p>
            </div>
            <div class="quizlet-back">
                <p id="wordDefinition" class="quizlet-definition">@Model.CurrentWord.Definition</p>
                <img id="wordImage" src="@Model.CurrentWord.ImagePath" alt="Image" />
            </div>
        </div>
    </div>

    <div class="quizlet-nav-btns-wrapper">
        <button id="BtnNext" class="quizlet-nav-btn btn-next">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>

@section Scripts {
    @* Flip the card when clicked *@
    <script type="text/javascript">
        function flipCard(card) {
            card.classList.toggle("flipped");
        }
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".quizlet-top-buttons").forEach(btnGroup => {
                btnGroup.addEventListener("click", function (e) {
                    e.stopPropagation();
                });
            });
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function () {

            // The initial word to be spoken (fetched from the server-side model)
            var firstText = "@Model.CurrentWord.Name";

            // Flashcard
            const card = document.getElementById("card");

            // Default voice name for speech synthesis
            var defaultVoiceName = "Microsoft Hazel - English (United Kingdom)";

            // Check if the browser supports the Speech Synthesis API
            if (speechSynthesis) {
                // Supported, continue
            } else {
                // Not supported, alert the user
                alert("Bad news! Your browser doesn't have the Speech Synthesis API this project requires. Try opening this webpage using the newest version of Google Chrome.");
            }

            // Create a new SpeechSynthesisUtterance instance
            var msg = new SpeechSynthesisUtterance();

            // When the list of available voices changes (e.g., loaded), set the desired voice
            speechSynthesis.addEventListener('voiceschanged', function () {
                msg.voice = speechSynthesis.getVoices().filter(function (voice) {
                    return voice.name == defaultVoiceName;
                })[0];

                // Speak the initial word
                speak(firstText);
            });

            // Function to speak a given text
            function speak(text) {
                // Cancel any ongoing speech
                window.speechSynthesis.cancel();

                // Set the text to be spoken
                msg.text = text;

                // Start speaking
                window.speechSynthesis.speak(msg);
            }

            // Index of the currently displayed word
            var currentIndex = 0;

            // Total number of words (from server-side model)
            var totalCount = @Model.Count;

            // ID of the current word (used for favorite action)
            var id = @Model.CurrentWord.Id;

            // Disable "Next" button if we're already at the last word
            $("#BtnNext").prop("disabled", currentIndex === totalCount - 1);

            // Function to load a word by index using AJAX
            function loadWord(index) {
                $.ajax({
                    url: '@Url.Action("SwitchWord", "Home")',
                    type: 'GET',
                    data: { index: index },
                    success: function (data) {
                        // If the card is flipped, flip it back
                        if (card.classList.contains("flipped")) {
                            card.classList.remove("flipped");
                        }

                        // Update the favorite button's background color
                        $("#BtnFav").css("background-color", data.isFavorite ? "yellow" : "transparent");

                        // Update counter, word name, definition, and image
                        $("#counter").text((index + 1) + "/" + totalCount);
                        $("#wordName").text(data.name);
                        $("#wordDefinition").text(data.definition);
                        $("#wordImage").attr("src", data.imagePath);

                        // Enable or disable navigation buttons
                        $("#BtnPrev").prop("disabled", index === 0);
                        $("#BtnNext").prop("disabled", index === totalCount - 1);

                        // Speak the new word
                        speak(data.name);

                        // Update current word ID and index
                        id = data.id;
                        currentIndex = index;
                    },
                    error: function () {
                        alert("No more items."); // Show alert if request fails
                    }
                });
            }

            // Handle click on "Next" button
            $("#BtnNext").on("click", function () {
                if (currentIndex < totalCount - 1) {
                    loadWord(currentIndex + 1);
                }
            });

            // Handle click on "Previous" button
            $("#BtnPrev").on("click", function () {
                if (currentIndex > 0) {
                    loadWord(currentIndex - 1);
                }
            });

            // Handle click on "Favorite" button
            $("#BtnFav").on("click", function () {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Favorite", "Home")',
                    data: { id: id },
                    success: function (res) {
                        // Change background color based on favorite status
                        if (res.isFavorite) {
                            $("#BtnFav").css("background-color", "yellow");
                        } else {
                            $("#BtnFav").css("background-color", "transparent");
                        }
                    }
                });
            });

            $("#BtnSound").on("click", function () {
                const word = $("#wordName").text().trim(); // Получаем текущее слово с карточки
                if (word) {
                    speak(word); // Используем уже определённую функцию
                }
        });
        });
    </script>
}