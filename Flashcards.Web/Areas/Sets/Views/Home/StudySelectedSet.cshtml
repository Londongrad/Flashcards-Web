@model CurrentWordViewModel

@{
    Layout = "_LayoutForStudyWords";
}

<!-- Кнопка "назад к предыдущему представлению" для десктопа-->
<a asp-area="Sets" asp-controller="Home" asp-action="SelectedSet" asp-route-id="@Model.CurrentWord.SetId"
   class="back-button-fixed mobile-hidden" id="BtnBack">
    <i class="bi bi-arrow-left-circle"></i> Back to the set
</a>

<!-- Счётчик -->
<div class="quizlet-counter">
    <h3 id="counter">1/@Model.Count</h3>
</div>

<!-- Layout карточки -->
<div class="quizlet-layout">
    <!-- Кнопка навигации по карточкам ("назад") для десктопа -->
    <div class="quizlet-nav-btns-wrapper desktop-only">
        <button id="BtnPrev" class="quizlet-nav-btn btn-prev">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <div class="quizlet-center-wrapper">
        <div id="card" class="quizlet-flip-container">
            <div class="quizlet-top-buttons">
                <a id="BtnSound" class="btn sound-fav-btn" title="Play sound">
                    <i class="bi bi-volume-up-fill"></i>
                </a>
                <a id="BtnFav" class="btn sound-fav-btn" title="Favorite"
                   style="background-color: @(!Model.CurrentWord.IsFavorite ? "transparent" : "yellow")">
                    <i class="bi bi-star-fill"></i>
                </a>
            </div>
            <div class="quizlet-flipper">
                <div class="quizlet-front">
                    <p id="wordName" class="quizlet-word">@Model.CurrentWord.Name</p>
                </div>
                <div class="quizlet-back">
                    <p id="wordDefinition" class="quizlet-definition responsive-text">@Model.CurrentWord.Definition</p>
                    <img id="wordImage" src="@Model.CurrentWord.ImagePath" alt="Image" />
                </div>
            </div>
        </div>
    </div>

    <!-- Кнопка навигации по карточкам ("вперед") для десктопа -->
    <div class="quizlet-nav-btns-wrapper desktop-only">
        <button id="BtnNext" class="quizlet-nav-btn btn-next">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>

<!-- Навигация по карточкам для мобильных -->
<div class="mobile-nav-btns-wrapper mobile-only">
    <button id="BtnPrevMobile" class="quizlet-nav-btn btn-prev">
        <i class="bi bi-chevron-left"></i>
    </button>
    <button id="BtnNextMobile" class="quizlet-nav-btn btn-next">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<!-- Кнопка "назад к предыдущему представлению" для мобилки-->
<div class="mobile-back-wrapper mobile-only">
    <a asp-area="Sets" asp-controller="Home" asp-action="SelectedSet" asp-route-id="@Model.CurrentWord.SetId"
       class="back-button-bottom">
        <i class="bi bi-arrow-left-circle"></i> Back to the set
    </a>
</div>

@section Scripts {
    @* Flip the card when clicked *@
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            const card = document.getElementById("card");
            const topButtons = card.querySelector(".quizlet-top-buttons");

            let isDragging = false;
            let mouseDown = false;

            // Блокируем клик на кнопках (звук, звезда)
            topButtons.querySelectorAll("a").forEach(button => {
                button.addEventListener("click", function (e) {
                    e.stopPropagation();
                });
            });

            // Отслеживаем, был ли drag (для выделения текста)
            card.addEventListener("mousedown", () => {
                mouseDown = true;
                isDragging = false;
            });

            card.addEventListener("mousemove", () => {
                if (mouseDown) {
                    isDragging = true;
                }
            });

            card.addEventListener("mouseup", () => {
                mouseDown = false;
            });

            // Сам переворот по click
            card.addEventListener("click", () => {
                if (!isDragging) {
                    flipCard(card);
                }
                isDragging = false; // сброс
            });
        });

        function flipCard(card) {
            card.classList.toggle("flipped");
        }
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            // Create a variable for speechSynthesis utterance
            let msg = null;
            let speechSupported = false;

            // Index of the currently displayed word
            let currentIndex = 0;

            // Total number of words (from server-side model)
            const totalCount = @Model.Count;

            // ID of the current word (used for favorite action)
            let id = @Model.CurrentWord.Id;

            // The initial word to be spoken (fetched from the server-side model)
            const firstText = "@Model.CurrentWord.Name";

            // The initial word's image to display or hide
            const firstImageUrl = "@Model.CurrentWord.ImagePath";

            // Flashcard
            const card = document.getElementById("card");

            // Default voice name for speech synthesis
            const defaultVoiceName = "Microsoft Hazel - English (United Kingdom)";

            // Проверка поддержки SpeechSynthesis
            if ('speechSynthesis' in window && typeof SpeechSynthesisUtterance !== "undefined") {
                msg = new SpeechSynthesisUtterance();
                speechSupported = true;

                // Установка голоса
                speechSynthesis.addEventListener('voiceschanged', function () {
                    msg.voice = speechSynthesis.getVoices().find(voice => voice.name === defaultVoiceName);
                    // Speak the initial word
                    speak(firstText);
                });
            } else {
                console.warn("Speech synthesis is not supported.");
            }

            imageToShowOrHide(firstImageUrl);

            // Function to speak a given text
            function speak(text) {
                if (!speechSupported || !msg) return;
                // Cancel any ongoing speech
                window.speechSynthesis.cancel();

                // Set the text to be spoken
                msg.text = text;

                // Start speaking
                window.speechSynthesis.speak(msg);
            }

            function imageToShowOrHide(url){
                if (url) {
                    $("#wordImage").attr("src", url).show();
                } else {
                    $("#wordImage").hide();
                }
            }

            // Disable "Next" button if we're already at the last/first word
            $("#BtnNext, #BtnNextMobile").prop("disabled", currentIndex === totalCount - 1);
            $("#BtnPrev, #BtnPrevMobile").prop("disabled", currentIndex === 0);

            // Function to load a word by index using AJAX
            function loadWord(index) {
                $.ajax({
                    url: '@Url.Action("SwitchWord", "Home")',
                    type: 'GET',
                    data: { index: index },
                    success: function (data) {
                        // If the card is flipped, flip it back
                        if (card.classList.contains("flipped")) {
                            card.classList.remove("flipped");
                        }

                        // Update the favorite button's background color
                        $("#BtnFav").css("background-color", data.isFavorite ? "yellow" : "transparent");

                        // Update counter, word name, definition, and image
                        $("#counter").text((index + 1) + "/" + totalCount);
                        $("#wordName").text(data.name);
                        $("#wordDefinition").text(data.definition);

                        imageToShowOrHide(data.imagePath);

                        // Enable or disable navigation buttons
                        $("#BtnPrev, #BtnPrevMobile").prop("disabled", index === 0);
                        $("#BtnNext, #BtnNextMobile").prop("disabled", index === totalCount - 1);

                        // Speak the new word
                        speak(data.name);

                        // Update current word ID and index
                        id = data.id;
                        currentIndex = index;
                    },
                    error: function (xhr) {
                        if (xhr.status === 401) {
                            // User session expired, show warning and redirect to login
                            toastr.warning("You have been logged out. Redirecting to the login page...");

                            setTimeout(function () {
                                window.location.href = "/Account/Account/Login";
                            }, 2000);
                        } else {
                            // General failure case
                            alert("No more items.");
                        }
                    }
                });
            }

            // Handle click on "Next" button
            $("#BtnNext, #BtnNextMobile").on("click", function () {
                if (currentIndex < totalCount - 1) {
                    loadWord(currentIndex + 1);
                }
            });

            // Handle click on "Previous" button
            $("#BtnPrev, #BtnPrevMobile").on("click", function () {
                if (currentIndex > 0) {
                    loadWord(currentIndex - 1);
                }
            });

            // Handle click on "Favorite" button
            $("#BtnFav").on("click", function () {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Favorite", "Home")',
                    data: { id: id },
                    success: function (res) {
                        // Change background color based on favorite status
                        if (res.isFavorite) {
                            $("#BtnFav").css("background-color", "yellow");
                        } else {
                            $("#BtnFav").css("background-color", "transparent");
                        }
                    }
                });
            });

            $("#BtnSound").on("click", function () {
                const word = $("#wordName").text().trim(); // Получаем текущее слово с карточки
                if (word) {
                    speak(word); // Используем уже определённую функцию
                }
            });
        });
    </script>
}