@model StudySetViewModel

@{
    Layout = "_LayoutForStudyWords";
}

<!-- Кнопка "назад к предыдущему представлению" для десктопа-->
<a asp-area="Sets" asp-controller="Home" asp-action="SelectedSet" asp-route-id="@Model.FirstWord.SetId"
   class="back-button-fixed mobile-hidden" id="BtnBack">
    <i class="bi bi-arrow-left-circle"></i> @Localizer["Back"] 
</a>

<!-- Счётчик -->
<div class="quizlet-counter">
    <h3 id="counter">1/@Model.Count</h3>
</div>

<!-- Кнопка "Settings" в правом верхнем углу -->
<a class="btn settings-modal-btn" id="BtnSettings" data-bs-toggle="modal" data-bs-target="#settingsModal" title="Settings">
    <i class="bi bi-gear-fill fs-4"></i>
</a>

<!-- Модальное окно -->
<div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-top-end modal-sm">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header">
                <h5 class="modal-title text-light" id="settingsModalLabel">@Localizer["VoiceSettings"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <label for="voiceSelect" class="form-label">@Localizer["SelectVoice"]</label>
                <select id="voiceSelect" class="form-select">
                    <!-- Опции будут добавлены динамически -->
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Layout карточки -->
<div class="quizlet-layout">
    <!-- Кнопка навигации по карточкам ("назад") для десктопа -->
    <div class="quizlet-nav-btns-wrapper desktop-only">
        <button id="BtnPrev" class="quizlet-nav-btn btn-prev">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <div class="quizlet-center-wrapper">
        <div id="card" class="quizlet-flip-container">

            <div class="quizlet-top-buttons">
                <a id="BtnFav" class="btn icon-btn" title="@Localizer["Favorite"]"
                   style="color: @(!Model.FirstWord.IsFavorite ? "white" : "gold")">
                    <i class="bi bi-star-fill"></i>
                </a>
                <a id="BtnSound" class="btn icon-btn" title="@Localizer["PlaySound"]">
                    <i class="bi bi-volume-up-fill"></i>
                </a>
            </div>

            <div class="quizlet-flipper">
                <div class="quizlet-front">
                    <p id="wordName" class="quizlet-word">@Model.FirstWord.Name</p>
                </div>
                <div class="quizlet-back">
                    <p id="wordDefinition" class="quizlet-definition responsive-text">@Model.FirstWord.Definition</p>
                    <img class="zoom-img" id="wordImage" src="@Model.FirstWord.ImagePath" alt="Image" />
                </div>
            </div>
        </div>
    </div>

    <!-- Кнопка навигации по карточкам ("вперед") для десктопа -->
    <div class="quizlet-nav-btns-wrapper desktop-only">
        <button id="BtnNext" class="quizlet-nav-btn btn-next">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>

<!-- Навигация по карточкам для мобильных -->
<div class="mobile-nav-btns-wrapper mobile-only">
    <button id="BtnPrevMobile" class="quizlet-nav-btn btn-prev">
        <i class="bi bi-chevron-left"></i>
    </button>
    <button id="BtnNextMobile" class="quizlet-nav-btn btn-next">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<!-- Кнопка "назад к предыдущему представлению" для мобилки-->
<div class="mobile-back-wrapper mobile-only">
    <a asp-area="Sets" asp-controller="Home" asp-action="SelectedSet" asp-route-id="@Model.FirstWord.SetId"
       class="back-button-bottom">
        <i class="bi bi-arrow-left-circle"></i> @Localizer["Back"]
    </a>
</div>

@section Scripts {
    <script>
        const words = JSON.parse('@Html.Raw(Model.WordsJson)');
        let currentIndex = 0;
        let id = words[0].Id;
        const setId = words[0].SetId;

        let speechSupported = false;
        const card = document.getElementById("card");
        let currentVoice = null;

        document.addEventListener("DOMContentLoaded", async function () {
            if ('speechSynthesis' in window && typeof SpeechSynthesisUtterance !== "undefined") {
                document.getElementById("BtnSettings").style.display = "inline-block";
            } else {
                document.getElementById("BtnSettings").style.display = "none";
                document.getElementById("BtnSound").style.display = "none";
            }

            initFlipCard();
            await initSpeechSynthesis();
            loadWord(currentIndex);
        });

        if (typeof speechSynthesis !== 'undefined') {
            speechSynthesis.onvoiceschanged = () => {
                const voices = speechSynthesis.getVoices();
                populateVoiceList(voices);
            };
        }

        document.getElementById("voiceSelect").addEventListener("change", function () {
            const selectedURI = this.value;
            const voices = speechSynthesis.getVoices();
            const selectedVoice = voices.find(v => v.voiceURI === selectedURI);

            if (selectedVoice) {
                localStorage.setItem("preferredVoiceURI", selectedVoice.voiceURI);
                currentVoice = selectedVoice;
            }
        });

        function initFlipCard() {
            const topButtons = card.querySelector(".quizlet-top-buttons");
            const wordImage = document.getElementById("wordImage");

            let isDragging = false;
            let mouseDown = false;

            topButtons.querySelectorAll("a").forEach(button => {
                button.addEventListener("click", function (e) {
                    e.stopPropagation();
                });
            });

            card.addEventListener("mousedown", () => {
                mouseDown = true;
                isDragging = false;
            });

            card.addEventListener("mousemove", () => {
                if (mouseDown) {
                    isDragging = true;
                }
            });

            card.addEventListener("mouseup", () => {
                mouseDown = false;
            });

            card.addEventListener("click", () => {
                if (!isDragging) {
                    flipCard(card);
                }
                isDragging = false;
            });

            if (wordImage) {
                wordImage.addEventListener("click", function (e) {
                    e.stopPropagation();
                });
            }

            $("#BtnPrev, #BtnPrevMobile").on("click", function () {
                if (currentIndex > 0) {
                    loadWord(currentIndex - 1);
                }
            });

            $("#BtnNext, #BtnNextMobile").on("click", function () {
                if (currentIndex < words.length - 1) {
                    loadWord(currentIndex + 1);
                }
            });

            $("#BtnFav").on("click", function () {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Favorite", "Home")',
                    data: { id: id, setId: setId },
                    success: function (res) {
                        console.log("Favorite result:", res);
                        $("#BtnFav").css("color", res.isFavorite ? "gold" : "white");
                        words[currentIndex].IsFavorite = res.isFavorite;
                    },
                    error: function (xhr) {
                        if (xhr.status === 401) {
                            handleSessionExpired();
                        }
                    }
                });
            });

            $("#BtnSound").on("click", function () {
                const word = $("#wordName").text().trim();
                if (word) {
                    speak(word);
                }
            });

            document.getElementById("wordImage").addEventListener("click", function () {
                const src = this.src;
                if (!src) return;

                const modal = document.createElement("div");
                modal.classList.add("image-overlay");

                const img = document.createElement("img");
                img.src = src;
                img.classList.add("zoomed-image");

                modal.appendChild(img);
                document.body.appendChild(modal);

                function closeModal() {
                    modal.classList.add("fade-out");
                    img.classList.add("zoom-out");

                    setTimeout(() => {
                        modal.remove();
                    }, 250);
                }

                modal.addEventListener("click", closeModal);

                document.addEventListener("keydown", function escListener(e) {
                    if (e.key === "Escape") {
                        closeModal();
                        document.removeEventListener("keydown", escListener);
                    }
                });
            });
        }

        function loadWord(index) {
            if (index < 0 || index >= words.length) return;

            const word = words[index];

            if (card.classList.contains("flipped")) {
                card.classList.remove("flipped");
            }

            $("#counter").text((index + 1) + "/" + words.length);
            $("#wordName").text(word.Name);
            $("#wordDefinition").text(word.Definition);
            updateImage(word.ImagePath);
            $("#BtnFav").css("color", word.IsFavorite ? "gold" : "white");

            $("#BtnPrev, #BtnPrevMobile").prop("disabled", index === 0);
            $("#BtnNext, #BtnNextMobile").prop("disabled", index === words.length - 1);

            speak(word.Name);

            id = word.Id;
            currentIndex = index;
        }

        function updateImage(url) {
            const wordImage = $("#wordImage");

            if (url) {
                wordImage.attr("src", url).show();
            } else {
                wordImage.hide();
            }
        }

        function flipCard(card) {
            card.classList.toggle("flipped");
        }

        function waitForVoicesToLoad(timeout = 3000) {
            return new Promise((resolve, reject) => {
                let voices = speechSynthesis.getVoices();
                if (voices.length) return resolve(voices);

                const interval = setInterval(() => {
                    voices = speechSynthesis.getVoices();
                    if (voices.length) {
                        clearInterval(interval);
                        resolve(voices);
                    }
                }, 100);

                setTimeout(() => {
                    clearInterval(interval);
                    reject("Voice loading timed out");
                }, timeout);
            });
        }

        async function initSpeechSynthesis() {
            if ('speechSynthesis' in window && typeof SpeechSynthesisUtterance !== "undefined") {
                speechSupported = true;

                const dummy = new SpeechSynthesisUtterance('');
                speechSynthesis.speak(dummy);
                speechSynthesis.cancel();

                try {
                    const voices = await waitForVoicesToLoad();
                    populateVoiceList(voices);
                } catch (err) {
                    console.warn("LoadVoicesError", err);
                }
            }
        }

        function populateVoiceList(voices) {
            const voiceSelect = document.getElementById("voiceSelect");
            voiceSelect.innerHTML = '';

            console.log("Available voices:", voices.map(v => `${v.name} (${v.lang})`));

            const savedURI = localStorage.getItem("preferredVoiceURI");

            voices.forEach((voice) => {
                const option = document.createElement("option");
                option.value = voice.voiceURI;
                option.textContent = `${voice.name} (${voice.lang})`;
                voiceSelect.appendChild(option);
            });

            const selectedVoice = voices.find(v => v.voiceURI === savedURI);

            if (selectedVoice) {
                voiceSelect.value = selectedVoice.voiceURI;
                currentVoice = selectedVoice;
            } else {
                currentVoice = voices[0];
                voiceSelect.value = voices[0].voiceURI;
            }
        }

        function speak(text) {
            if (!speechSupported || !currentVoice) return;

            const utterance = new SpeechSynthesisUtterance(text);
            utterance.voice = currentVoice;

            speechSynthesis.cancel();
            speechSynthesis.speak(utterance);
        }

        function handleSessionExpired() {
            toastr.warning("@Localizer["ToastrLogout"]");
            setTimeout(() => {
                window.location.href = "/Account/Account/Login";
            }, 2000);
        }

        setInterval(() => {
            console.log("Checking auth at", new Date());

            fetch('/Account/Account/IsAuthenticated?ts=' + Date.now(), {
                method: 'GET',
                credentials: 'include'
            })
            .then(res => {
                console.log("Auth status:", res.status);
                if (res.status === 401) {
                    handleSessionExpired();
                }
            })
            .catch(() => {
                console.error("Auth check failed:", err);
                toastr.error("@Localizer["LostConn"]");
                setTimeout(() => {
                    window.location.href = "/Account/Account/Login";
                }, 2000);
            });
        }, 30000);
    </script>
}