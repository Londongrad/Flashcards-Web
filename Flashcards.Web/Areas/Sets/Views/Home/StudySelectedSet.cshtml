@model CurrentWordViewModel

@{
    Layout = "_LayoutForStudyWords";
}

<div style="margin-top: 60px;" id="divToStudy">
    <div class="d-flex justify-content-center align-items-center mx-0">

        <button disabled id="BtnPrev" class="btn btn-primary bg-black mx-2 align-content-center" style="width: 20px; height: 90px">
            <i class="bi bi-chevron-left"></i>
        </button>

        <div>
            <div class="row text-center align-items-center mx-0 w-100">
                <a asp-area="Sets" asp-controller="Home" asp-action="SelectedSet" asp-route-id="@Model.CurrentWord.SetId" type="button" class="btn btn-primary text-bg-dark col-3">
                    <i class="bi bi-arrow-down-left-circle"></i> Back to the set
                </a>

                <h3 id="counter" class="text-white col-6 m-0">1/@Model.Count</h3>

                <div class="col-3 text-end">
                    <a id="BtnFav" class="btn sound-fav-btn" title="Favorite"
                       style="background-color: @(!Model.CurrentWord.IsFavorite ? "transparent" : "yellow")">
                        <i class="bi bi-star-fill"></i>
                    </a>
                </div>
            </div>

            <div class="tile mt-2">
                <div class="text-center tile__face">
                    <p class="text-white text-to-learn" id="wordName">@Model.CurrentWord.Name</p>
                </div>

                <div class="text-center tile__face tile__face--back" style="height: 400px; width: auto; margin-top: 10px;">
                    @if (!string.IsNullOrEmpty(Model.CurrentWord.ImagePath))
                    {
                        <img id="wordImage" src="@Model.CurrentWord.ImagePath" />
                    }
                </div>

                <div class="text-center text-white text-to-learn tile__face tile__face--back">
                    <p id="wordDefinition">@Model.CurrentWord.Definition</p>
                </div>
            </div>
        </div>

        <button id="BtnNext" class="btn btn-primary text-bg-dark-subtle mx-2 align-content-center" style="width: 20px; height: 90px">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>

@section Scripts {
    @* Flip the card *@
    <script type="text/javascript">
        const tile = document.querySelector(".tile");
        tile.addEventListener("click", function () {
            tile.classList.toggle("is-flipped");
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function() {

            var firstText = "@Model.CurrentWord.Name";

            var defaultVoiceName = "Microsoft Hazel - English (United Kingdom)";

            if (speechSynthesis) {
            } else {
                alert("Bad news! Your browser doesn't have the Speech Synthesis API this project requires. Try opening this webpage using the newest version of Google Chrome.");
            }

            // Create a new instance of SpeechSynthesisUtterance.
            var msg = new SpeechSynthesisUtterance();

            speechSynthesis.addEventListener('voiceschanged', function() {
                // Set voice
                msg.voice = speechSynthesis.getVoices().filter(function(voice) { return voice.name == defaultVoiceName })[0];
                speak(firstText);
            });

            // Create a new utterance for the specified text and add it to
            // the queue.
            function speak(text) {
                // Stop the previous tts
                window.speechSynthesis.cancel();

                // Set the text.
                msg.text = text;

                // Queue this utterance.
                window.speechSynthesis.speak(msg);
            }

            var currentIndex = 0;
            var totalCount = @Model.Count;
            var id = @Model.CurrentWord.Id;

            $("#BtnNext").prop("disabled", currentIndex === totalCount - 1);

            function loadWord(index) {
                $.ajax({
                    url: '@Url.Action("SwitchWord", "Home")',
                    type: 'GET',
                    data: { index: index },
                    success: function (data) {
                        if($('.tile').hasClass("is-flipped")){
                            tile.classList.toggle("is-flipped");
                        }
                        $("#BtnFav").css("background-color", data.isFavorite ? "yellow" : "transparent");

                        $("#counter").text((index + 1) + "/" + totalCount);
                        $("#wordName").text(data.name);
                        $("#wordDefinition").text(data.definition);
                        $("#wordImage").attr("src", data.imagePath);

                        // Enable/Disable buttons based on index
                        $("#BtnPrev").prop("disabled", index === 0);
                        $("#BtnNext").prop("disabled", index === totalCount - 1);

                        speak(data.name);

                        id = data.id;
                        currentIndex = index;
                    },
                    error: function () {
                        alert("No more items.");
                    }
                });
            }

            $("#BtnNext").on("click", function () {
                if (currentIndex < totalCount - 1) {
                    loadWord(currentIndex + 1);
                }
            });

            $("#BtnPrev").on("click", function () {
                if (currentIndex > 0) {
                    loadWord(currentIndex - 1);
                }
            });

            $("#BtnFav").on("click", function () {
                $.ajax({
                    type: "POST",
                    url:  '@Url.Action("Favorite", "Home")',
                    data: { id: id },
                    success: function (res) {
                        if (res.isFavorite) {
                            $("#BtnFav").css("background-color", "yellow");
                        }
                        else {
                            $("#BtnFav").css("background-color", "transparent");
                        }
                    }
                })
            });
        });
    </script>
}