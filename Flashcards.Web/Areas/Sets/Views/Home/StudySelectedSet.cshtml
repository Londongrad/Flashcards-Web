@model StudySetViewModel

@{
    Layout = "_LayoutForStudyWords";
}

<!-- Кнопка "назад к предыдущему представлению" для десктопа-->
<a asp-area="Sets" asp-controller="Home" asp-action="SelectedSet" asp-route-id="@Model.FirstWord.SetId"
   class="back-button-fixed mobile-hidden" id="BtnBack">
    <i class="bi bi-arrow-left-circle"></i> Back to the set
</a>

<!-- Счётчик -->
<div class="quizlet-counter">
    <h3 id="counter">1/@Model.Count</h3>
</div>

<!-- Layout карточки -->
<div class="quizlet-layout">
    <!-- Кнопка навигации по карточкам ("назад") для десктопа -->
    <div class="quizlet-nav-btns-wrapper desktop-only">
        <button id="BtnPrev" class="quizlet-nav-btn btn-prev">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <div class="quizlet-center-wrapper">
        <div id="card" class="quizlet-flip-container">
            <div class="quizlet-top-buttons">
                <a id="BtnSound" class="btn sound-fav-btn" title="Play sound">
                    <i class="bi bi-volume-up-fill"></i>
                </a>
                <a id="BtnFav" class="btn sound-fav-btn" title="Favorite"
                   style="background-color: @(!Model.FirstWord.IsFavorite ? "transparent" : "yellow")">
                    <i class="bi bi-star-fill"></i>
                </a>
            </div>
            <div class="quizlet-flipper">
                <div class="quizlet-front">
                    <p id="wordName" class="quizlet-word">@Model.FirstWord.Name</p>
                </div>
                <div class="quizlet-back">
                    <p id="wordDefinition" class="quizlet-definition responsive-text">@Model.FirstWord.Definition</p>
                    <img class="zoom-img" id="wordImage" src="@Model.FirstWord.ImagePath" alt="Image" />
                </div>
            </div>
        </div>
    </div>

    <!-- Кнопка навигации по карточкам ("вперед") для десктопа -->
    <div class="quizlet-nav-btns-wrapper desktop-only">
        <button id="BtnNext" class="quizlet-nav-btn btn-next">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>

<!-- Навигация по карточкам для мобильных -->
<div class="mobile-nav-btns-wrapper mobile-only">
    <button id="BtnPrevMobile" class="quizlet-nav-btn btn-prev">
        <i class="bi bi-chevron-left"></i>
    </button>
    <button id="BtnNextMobile" class="quizlet-nav-btn btn-next">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<!-- Кнопка "назад к предыдущему представлению" для мобилки-->
<div class="mobile-back-wrapper mobile-only">
    <a asp-area="Sets" asp-controller="Home" asp-action="SelectedSet" asp-route-id="@Model.FirstWord.SetId"
       class="back-button-bottom">
        <i class="bi bi-arrow-left-circle"></i> Back to the set
    </a>
</div>


@section Scripts {
    <script>
        const words = JSON.parse('@Html.Raw(Model.WordsJson)');
        let currentIndex = 0;
        let id = words[0].Id;

        // Create a variable for speechSynthesis utterance, default voice and get the card
        let msg = null;
        let speechSupported = false;
        const defaultVoiceName = "Microsoft Hazel - English (United Kingdom)";
        const card = document.getElementById("card");

        // For zoom purposes (on mobile it should be bigger)
        const isMobile = window.innerWidth < 768;
        let zoomInstance = null;

        document.addEventListener("DOMContentLoaded", function () {
            initFlipCard();
            initSpeechSynthesis();
            loadWord(currentIndex);
        });

        function initFlipCard() {
            const topButtons = card.querySelector(".quizlet-top-buttons");
            const wordImage = document.getElementById("wordImage");

            let isDragging = false;
            let mouseDown = false;

            topButtons.querySelectorAll("a").forEach(button => {
                button.addEventListener("click", function (e) {
                    e.stopPropagation();
                });
            });

            card.addEventListener("mousedown", () => {
                mouseDown = true;
                isDragging = false;
            });

            card.addEventListener("mousemove", () => {
                if (mouseDown) {
                    isDragging = true;
                }
            });

            card.addEventListener("mouseup", () => {
                mouseDown = false;
            });

            card.addEventListener("click", () => {
                if (!isDragging) {
                    flipCard(card);
                }
                isDragging = false;
            });

            if (wordImage) {
                wordImage.addEventListener("click", function (e) {
                    e.stopPropagation();
                    if (zoomInstance) {
                        zoomInstance.open({ target: wordImage });
                    }
                });
            }

            // Handle click on "Previous" buttons
            $("#BtnPrev, #BtnPrevMobile").on("click", function () {
                if (currentIndex > 0) {
                    loadWord(currentIndex - 1);
                }
            });

            // Handle click on "Next" buttons
            $("#BtnNext, #BtnNextMobile").on("click", function () {
                if (currentIndex < words.length - 1) {
                    loadWord(currentIndex + 1);
                }
            });

            // Handle click on "Favorite" button
            $("#BtnFav").on("click", function () {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Favorite", "Home")',
                    data: { id: id },
                    success: function (res) {
                        console.log("Favorite result:", res);
                        // Change background color based on favorite status
                        $("#BtnFav").css("background-color", res.isFavorite ? "yellow" : "transparent");
                        words[currentIndex].IsFavorite = res.isFavorite;
                    },
                    error: function (xhr) {
                        if (xhr.status === 401) {
                            handleSessionExpired();
                        }
                    }
                });
            });

            $("#BtnSound").on("click", function () {
                const word = $("#wordName").text().trim();
                if (word) {
                    speak(word);
                }
            });
        }

        function loadWord(index) {
            if (index < 0 || index >= words.length) return;

            const word = words[index];

            if (card.classList.contains("flipped")) {
                card.classList.remove("flipped");
            }

            $("#counter").text((index + 1) + "/" + words.length);
            $("#wordName").text(word.Name);
            $("#wordDefinition").text(word.Definition);
            updateImage(word.ImagePath);
            $("#BtnFav").css("background-color", word.IsFavorite ? "yellow" : "transparent");

            $("#BtnPrev, #BtnPrevMobile").prop("disabled", index === 0);
            $("#BtnNext, #BtnNextMobile").prop("disabled", index === words.length - 1);

            speak(word.Name);

            id = word.Id;
            currentIndex = index;
        }

        function updateImage(url) {
            if (url) {
                $("#wordImage").attr("src", url).show();
            } else {
                $("#wordImage").hide();
            }
        }

        function flipCard(card) {
            const wasFlipped = card.classList.contains("flipped");
            card.classList.toggle("flipped");

            if (!wasFlipped) {
                setTimeout(() => {
                    const zoomTarget = document.querySelector('.quizlet-back .zoom-img');
                    if (zoomTarget) {
                        if (!zoomInstance) {
                            zoomInstance = mediumZoom(zoomTarget, {
                                margin: isMobile ? 5 : 50,
                                background: "rgba(0, 0, 0, 0.7)"
                            });
                        } else {
                            zoomInstance.attach(zoomTarget);
                        }
                    }
                }, 350);
            }
        }

        function initSpeechSynthesis() {
            if ('speechSynthesis' in window && typeof SpeechSynthesisUtterance !== "undefined") {
                msg = new SpeechSynthesisUtterance();
                speechSupported = true;

                speechSynthesis.addEventListener('voiceschanged', function () {
                    msg.voice = speechSynthesis.getVoices().find(voice => voice.name === defaultVoiceName);
                    speak(words[currentIndex].Name);
                });
            } else {
                console.warn("Speech synthesis is not supported.");
            }
        }

        // TTS
        function speak(text) {
            if (!speechSupported || !msg) return;
            window.speechSynthesis.cancel();
            msg.text = text;
            window.speechSynthesis.speak(msg);
        }

        function handleSessionExpired() {
            toastr.warning("You have been logged out. Redirecting to the login page...");
            setTimeout(() => {
                window.location.href = "/Account/Account/Login";
            }, 2000);
        }

        // Optional: periodic session check
        setInterval(() => {
            console.log("Checking auth at", new Date());

            fetch('/Account/Account/IsAuthenticated?ts=' + Date.now(), {
                method: 'GET',
                credentials: 'include'
            })
            .then(res => {
                console.log("Auth status:", res.status);
                if (res.status === 401) {
                    handleSessionExpired();
                }
            })
            .catch(() => {
                console.error("Auth check failed:", err);
                toastr.error("Lost connection to server. Redirecting...");
                setTimeout(() => {
                    window.location.href = "/Account/Account/Login";
                }, 2000);
            });
        }, 5000); // every 30 seconds
    </script>
}