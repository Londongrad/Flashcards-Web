@model List<SetViewModel>
@{
    ViewData["Title"] = "Flashcards";
}

<div class="row pt-4 pb-3">

    <h2 class="text-light mb-0 col-6 align-content-center">
        your library
    </h2>

    <div class="col-6 text-end">
        <a onclick="showInPopup('@Url.Action("AddOrEditSet", "Home", null, Context.Request.Scheme)', 'New set')" title="Create new set" class="btn btn-secondary">
            <i class="bi bi-plus-lg"></i> Add new set
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="row m-5">
            <img src="~/images/empty.png" style="width: 70px; height: 60px;" class="col-2 mx-1 p-0"/>
            <h2 class="text-light col-10 m-0 p-0">
                Currently you don't have any sets in your library.
                Add one by pressing button above.
            </h2>
        </div>
    }
    else
    {
        @foreach (var set in Model.OrderByDescending(x => x.Id))
        {
            <form>
                <div class="card border-0" style="background-color: transparent;">
                    <button type="submit" asp-area="Sets" asp-controller="Home" asp-action="SelectedSet" asp-route-id="@set.Id" class="btn btn-primary mt-2 my-card">
                        <div class="card-body">
                            <div class="card-title">@set.Name</div>
                            <div class="card-text">@set.Words?.Count termins</div>
                        </div>
                    </button>
                </div>
            </form>
        }
    }
</div>


@* Add/Edit set popup menu *@
<div class="modal fade" id="form-modal" tabindex="-1" aria-labelledby="addset" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="addset"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

            </div>
        </div>
    </div>
</div>