@model List<SetSummaryViewModel>
@{
    ViewData["Title"] = Localizer["Flashcards"];
}

<div class="py-3 m-1">
    @if (!Model.Any())
    {
        <div class="empty-library-container">
            <div class="empty-card">
                <img src="/images/empty.png" alt="No sets" class="empty-illustration">
                <h2>@Localizer["EmptyLib"]</h2>
                <p class="text-light">@Localizer["EmptyUser"]</p>
                <a onclick="showInPopup('@Url.Action("AddOrEditSet", "Home")', '@Localizer["NewSet"]')" class="btn btn-custom-dark">
                    <i class="bi bi-plus-circle"></i> @Localizer["AddNewSet"]
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0">@Localizer["MySets"]</h2>
            <a onclick="showInPopup('@Url.Action("AddOrEditSet", "Home")', '@Localizer["NewSet"]')" class="btn btn-custom-dark">
                <i class="bi bi-plus-lg"></i> @Localizer["AddNewSet"]
            </a>
        </div>

        <div class="row g-3">
            @foreach (var set in Model.OrderByDescending(x => x.Id))
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <form class="set-form">
                        <button type="submit"
                                asp-area="Sets"
                                asp-controller="Home"
                                asp-action="SelectedSet"
                                asp-route-id="@set.Id"
                                class="set-card w-100 border-0 text-start">

                            <div class="set-info">
                                <div class="set-title">@set.Name</div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>@set.WordCount @Localizer["Termins"]</div>

                                    @if (set.HasImages)
                                    {
                                        <i class="bi bi-image ms-2"></i>
                                    }
                                </div>
                            </div>

                            <i class="bi bi-book"></i>
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>