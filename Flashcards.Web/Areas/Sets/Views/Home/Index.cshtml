@model List<SetViewModel>
@{
    ViewData["Title"] = "Flashcards";
}

<div class="pt-4 pb-3 m-5">
    @if (!Model.Any())
    {
        <div class="empty-library-container">
            <div class="empty-card">
                <img src="/images/empty.png" alt="No sets" class="empty-illustration">
                <h2>Your library is empty</h2>
                <p class="text-light">You don't have any sets yet. Click the button below to create one.</p>
                <a onclick="showInPopup('@Url.Action("AddOrEditSet", "Home")', 'New set')" title="Create new set" class="btn btn-custom-dark">
                    <i class="bi bi-plus-circle"></i> Add New Set
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0">My Sets</h2>
            <a onclick="showInPopup('@Url.Action("AddOrEditSet", "Home")', 'New set')" title="Create new set" class="btn btn-custom-dark">
                <i class="bi bi-plus-lg"></i> Add new set
            </a>
        </div>

        <div class="row g-3">
            @foreach (var set in Model.OrderByDescending(x => x.Id))
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <form class="set-form">
                        <button type="submit"
                                asp-area="Sets"
                                asp-controller="Home"
                                asp-action="SelectedSet"
                                asp-route-id="@set.Id"
                                class="set-card w-100 border-0 text-start">

                            <div class="set-info">
                                <div class="set-title">@set.Name</div>
                                <div class="set-terms">@set.Words?.Count termins</div>
                            </div>

                            <i class="bi bi-book"></i>
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>