@model SetViewModel

<input hidden asp-for="Id" />

<div class="d-flex flex-column flex-md-row justify-content-center align-items-center text-light py-3 border-secondary-subtle gap-2 text-center">
    <!-- Текст -->
    <p class="mb-0 responsive-text">
        Name of the set is <strong id="setName" class="text-white">@Model.Name</strong>.
        This set has in total <strong id="numWords" class="text-white">@Model.Words?.Count</strong>
        <strong id="word" class="text-white">@(Model.Words?.Count == 1 ? "word" : "words")</strong>
    </p>

    <!-- Кнопки справа (будут под текстом на мобилке, справа — на широких экранах) -->
    <div class="d-flex gap-2 align-items-center justify-content-center">
        <a onclick="showInPopup('@Url.Action("AddOrEditSet", "Home", new { Model.Id })', 'Edit set')" class="btn sound-fav-btn" title="Edit name of the set">
            <i class="bi bi-pencil-square fs-5 text-light"></i>
        </a>
        <button id="deleteSet" title="Delete set" class="btn sound-fav-btn">
            <i class="bi bi-trash3 fs-5 text-light"></i>
        </button>
    </div>
</div>

<div class="justify-content-center align-items-center text-center mx-5">
    @* Navigation buttons + add new *@
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 button-container">
        <div class="d-flex flex-wrap justify-content-center gap-2 flex-grow-1">
            <a asp-area="Sets" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Back
            </a>

            <button onclick="location.href='@Url.Action("StudySelectedSet", "Home", new { Model.Id, flag = false })'" id="BtnStudy" class="btn btn-outline-light btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-play-circle"></i> Study
            </button>

            <button onclick="location.href='@Url.Action("StudySelectedSet", "Home", new { id = Model.Id, flag = true })'" id="BtnStudyFav" type="button" class="btn btn-outline-light btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-star"></i> Favorite [@Model.Words?.Where(w => w.IsFavorite == true).Count() words]
            </button>

            <a onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { setId = Model.Id })', 'Add new word')" title="Create new word" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> Add
            </a>
        </div>
    </div>

    @* Collection of Words *@
    @foreach (var word in Model.Words!)
    {
        <div class="quizlet-card">
            <div class="quizlet-block word">
                <p class="mb-0">@word.Name</p>
            </div>

            <div class="divider"></div> <!-- Вертикальная линия -->

            <div class="quizlet-block definition">
                <p class="mb-0">@word.Definition</p>
            </div>

            <div class="quizlet-block image">
                @if (!string.IsNullOrEmpty(@word.ImagePath))
                {
                    <img src="@word.ImagePath" class="zoom-img" asp-append-version="true" />
                }
                else
                {
                    <p class="no-image mb-0">No image</p>
                }
            </div>

            <div class="quizlet-block actions">
                <button onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { word.SetId, word.Id })', 'Edit word')" class="quizlet-btn edit">
                    <i class="bi bi-pencil"></i>
                </button>
                <button data-id="@word.Id" class="quizlet-btn delete deleteWord">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>
    }
    <button id="scrollToBottomBtn" title="Scroll to bottom">
        <i class="bi bi-arrow-down-short"></i>
    </button>
</div>

@section Scripts {
    @*Scroll to the bottom button*@
    <script type="text/javascript">
        const scrollBtn = document.getElementById("scrollToBottomBtn");

        window.addEventListener("scroll", () => {
            if (window.scrollY > 100) {
                scrollBtn.classList.add("show");
            } else {
                scrollBtn.classList.remove("show");
            }
        });

        scrollBtn.addEventListener("click", () => {
            window.scrollTo({
                top: document.body.scrollHeight,
                behavior: "smooth"
            });
        });
    </script>

    @* Image Zoom *@
    <script type="text/javascript">
        const isMobile = window.innerWidth < 768;

        mediumZoom('.zoom-img', {
            margin: isMobile ? 5 : 50,
            background: "transparent"
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function() {

            var count = @Model.Words.Count;
            var countFav = @Model.Words.Where(w => w.IsFavorite == true).Count();
            var setId = @Model.Id;

            $("#BtnStudy").prop("disabled", count === 0);
            $("#BtnStudyFav").prop("disabled", countFav === 0);

            $(".deleteWord").on("click", function () {
                var id = $(this).data("id");
                var card = $(this).closest(".quizlet-card");

                bootbox.confirm("Do you really wanna delete this word?", function(result) {
                    if(result){
                        $.ajax({
                            url: '@Url.Action("DeleteWord", "Home")',
                            type: "POST",
                            data: { id: id },
                            success: function(res) {
                                count -= 1;

                                $("#numWords").text(count);
                                $("#word").text(count === 1 ? "word" : "words");

                                toastr.success("The word has been successfully deleted");

                                card.css('background','tomato');
                                card.fadeOut(800, function(){
                                    $(this).remove();
                                });

                                $("#BtnStudy").prop("disabled", count === 0);
                                $("#BtnStudyFav").prop("disabled", countFav === 0);
                            }
                        });
                    }
                });
            });

            $("#deleteSet").on("click", function () {
                bootbox.confirm("Do you really wanna delete this set?", function(result) {
                    if(result){
                        $.ajax({
                            url: '@Url.Action("DeleteSet", "Home")',
                            type: "POST",
                            data: { id: setId },
                            success: function(res) {
                                window.location.href = '@Url.Action("Index", "Home")';
                            }
                        });
                    }
                });
            });
        });
    </script>
}