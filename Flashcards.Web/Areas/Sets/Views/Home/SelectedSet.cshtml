@model SetViewModel

<input hidden asp-for="Id" />

<p class="text-large text-light text-center my-5">
    Name of the set is <strong id="setName">@Model.Name</strong>. This set has in total <strong id="numWords">@Model.Words?.Count</strong> <strong id="word">@(Model.Words?.Count == 1 ? "word" : "words")</strong>
    <a onclick="showInPopup('@Url.Action("AddOrEditSet", "Home", new { Model.Id })', 'Edit set')" class="btn sound-fav-btn" title="Edit name of the set">
        <i class="bi bi-pencil-square"></i>
    </a>
    <button id="deleteSet" title="Delete set" class="btn text-truncate sound-fav-btn">
        <i class="bi bi-trash3"></i>
    </button>
</p>

<div class="justify-content-center align-items-center text-center mx-5">

    <div class="d-flex flex-nowrap align-items-end justify-content-between w-100 gap-2 flex-button-row" style="min-height: 80px;">
        <!-- Левая кнопка -->
        <div class="flex-shrink-0">
            <a asp-area="Sets" asp-controller="Home" asp-action="Index" class="btn btn-primary border-1 border-dark-subtle text-bg-dark text-truncate" style="max-width: 140px;">
                <i class="bi bi-arrow-down-left-circle"></i> Back
            </a>
        </div>

        <!-- Центральные кнопки -->
        <div class="d-flex flex-nowrap justify-content-center flex-grow-1 center-buttons" style="min-width: 0;">
            <button onclick="location.href='@Url.Action("StudySelectedSet", "Home", new { Model.Id, flag = false })'" id="BtnStudy" class="btn btn-primary border-1 border-dark-subtle text-bg-dark text-truncate">
                <i class="bi bi-yin-yang"></i> Study this set
            </button>

            <button onclick="location.href='@Url.Action("StudySelectedSet", "Home", new { id = Model.Id, flag = true })'" id="BtnStudyFav" type="button" class="btn btn-primary border-1 border-dark-subtle text-bg-dark text-truncate">
                <i class="bi bi-yin-yang"></i> Study only favorite [@Model.Words?.Where(w => w.IsFavorite == true).Count() words]
            </button>

            <a onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { setId = Model.Id })', 'Add new word')" title="Create new word" class="btn btn-primary border-1 border-dark-subtle text-bg-dark text-truncate">
                <i class="bi bi-plus-lg"></i> Add new word
            </a>
        </div>
    </div>
    @foreach (var word in Model.Words!)
    {
        <div class="quizlet-card">
            <div class="quizlet-block word">
                <p>@word.Name</p>
            </div>

            <div class="quizlet-block definition">
                <p>@word.Definition</p>
            </div>

            <div class="quizlet-block image">
                @if (!string.IsNullOrEmpty(@word.ImagePath))
                {
                    <img src="@word.ImagePath" class="zoom-img" asp-append-version="true" />
                }
                else
                {
                    <p class="no-image">No image</p>
                }
            </div>

            <div class="quizlet-block actions ">
                <button onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { word.SetId, word.Id })', 'Edit word')" class="quizlet-btn edit">
                    <i class="bi bi-pencil"></i> Edit
                </button>
                <button data-id="@word.Id" class="quizlet-btn delete deleteWord">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script type="text/javascript">
        const isMobile = window.innerWidth < 768;

        mediumZoom('.zoom-img', {
            margin: isMobile ? 5 : 50,
            background: "transparent"
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function() {

            var count = @Model.Words.Count;
            var countFav = @Model.Words.Where(w => w.IsFavorite == true).Count();
            var setId = @Model.Id;

            $("#BtnStudy").prop("disabled", count === 0);
            $("#BtnStudyFav").prop("disabled", countFav === 0);

            $(".deleteWord").on("click", function () {
                var id = $(this).data("id");
                bootbox.confirm("Do you really wanna delete this word?", function(result) {
                    if(result){
                        $.ajax({
                            url: '@Url.Action("DeleteWord", "Home")',
                            type: "POST",
                            data: { id: id },
                            success: function(res) {
                                count -= 1;

                                $("#numWords").text(count);
                                $("#word").text(count === 1 ? "word" : "words");

                                toastr.success("The word has been successfully deleted");

                                $("#tableRow-" + id).css('background','tomato');
                                $("#tableRow-" + id).fadeOut(800, function(){
                                    $(this).remove();
                                });

                                $("#BtnStudy").prop("disabled", count === 0);
                                $("#BtnStudyFav").prop("disabled", countFav === 0);
                            }
                        });
                    }
                });
            });

            $("#deleteSet").on("click", function () {
                bootbox.confirm("Do you really wanna delete this set?", function(result) {
                    if(result){
                        $.ajax({
                            url: '@Url.Action("DeleteSet", "Home")',
                            type: "POST",
                            data: { id: setId },
                            success: function(res) {
                                window.location.href = '@Url.Action("Index", "Home")';
                            }
                        });
                    }
                });
            });
        });
    </script>
}