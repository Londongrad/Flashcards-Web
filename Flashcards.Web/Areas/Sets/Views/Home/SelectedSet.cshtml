@model SetViewModel

<h2 class="text-light text-center my-5">Name of the set is @Model.Name. This set has in total @Model.Words?.Count words</h2>

<table class="table table-bordered table-striped border-light text-light">
    <thead>
        <tr class="text-center">
            <th>Word</th>
            <th>Definition</th>
            <th>Image</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var word in Model.Words!)
        {
            <tr style="text-align: center; vertical-align: middle">
                <td>@word.Name</td>
                <td>@word.Definition</td>
                <td><img src="@word.ImagePath" alt="" width="100" asp-append-version="true"/></td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-area="" asp-controller="" asp-action="" class="btn btn-primary border-black border-1 bg-black m-1 p-2 text-center text-nowrap">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>

                        <a asp-area="" asp-controller="" asp-action="" class="btn btn-primary border-black bg-black border-1 m-1 p-2 text-nowrap text-center">
                            <i class="bi bi-trash-fill"></i> Delete
                        </a>
                    </div>

                </td>
            </tr>
        }
    </tbody>
</table>