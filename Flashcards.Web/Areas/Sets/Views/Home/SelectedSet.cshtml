@model SetViewModel

@{
    int? favCount = Model.Words?.Where(w => w.IsFavorite == true).Count();
}

<input hidden asp-for="Id" />

<div class="d-flex flex-column flex-md-row justify-content-center align-items-center text-light py-3 border-secondary-subtle gap-2 text-center">
    <!-- Текст -->
    <p class="mb-0 responsive-text">
        @Localizer["SetName"]<strong id="setName" class="text-white">@Model.Name</strong>.
        @Localizer["SetCount"]<strong id="numWords" class="text-white">@Model.Words?.Count</strong>
        <strong id="word" class="text-white">@(Model.Words?.Count == 1 ? Localizer["Word"] : Localizer["Words"])</strong>
    </p>

    <!-- Кнопки справа (будут под текстом на мобилке, справа — на широких экранах) -->
    <div class="d-flex gap-2 align-items-center justify-content-center">
        <button onclick="showInPopup('@Url.Action("AddOrEditSet", "Home", new { Model.Id })', '@Localizer["EditSet"]')" class="icon-btn" title="@Localizer["EditSet"]">
            <i class="bi bi-pencil-square fs-5 text-light"></i>
        </button>
        <button id="deleteSet" title="@Localizer["DeleteSet"]" class="icon-btn">
            <i class="bi bi-trash3 fs-5 text-light"></i>
        </button>
    </div>
</div>

<div class="justify-content-center align-items-center text-center mx-5">
    @* Navigation buttons + add new *@
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 button-container">
        <div class="d-flex flex-wrap justify-content-center gap-2 flex-grow-1">
            <a asp-area="Sets" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> @Localizer["Back"]
            </a>

            <button onclick="location.href='@Url.Action("StudySelectedSet", "Home", new { Model.Id, flag = false })'" id="BtnStudy" class="btn btn-outline-light btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-play-circle"></i> @Localizer["Study"]
            </button>

            <button onclick="location.href='@Url.Action("StudySelectedSet", "Home", new { id = Model.Id, flag = true })'"
                    id="BtnStudyFav"
                    type="button"
                    class="btn btn-outline-light btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-star"></i>
                @Localizer["StudyFavorite"]
                [<span id="FavCount">@favCount</span>
                <span id="FavWordLabel">@((favCount == 1) ? Localizer["Word"] : Localizer["Words"])</span>]
            </button>

            <a onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { setId = Model.Id })', '@Localizer["AddNewWord"]')" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> @Localizer["Add"]
            </a>
        </div>
    </div>

    @* Collection of Words *@
    @foreach (var word in Model.Words!)
    {
        <div class="quizlet-card">
            <div class="quizlet-block word">
                <p class="mb-0">@word.Name</p>
            </div>

            <div class="divider"></div> <!-- Вертикальная линия -->

            <div class="quizlet-block definition">
                <p class="mb-0">@word.Definition</p>
            </div>

            <div class="quizlet-block image">
                @if (!string.IsNullOrEmpty(@word.ImagePath))
                {
                    <img src="@word.ImagePath" class="zoom-img" asp-append-version="true" />
                }
                else
                {
                    <p class="no-image mb-0">@Localizer["NoImage"]</p>
                }
            </div>

            <div class="quizlet-block actions">
                <div class="quizlet-block actions">
                    <button id="BtnFavSel" class="icon-btn fav-btn fav-btn-in-sel @(word.IsFavorite ? "favorited" : "")" data-id="@word.Id" data-setid="@word.SetId" title="@Localizer["Favorite"]">
                        <i class="bi bi-star-fill"></i>
                    </button>
                    <button onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { word.SetId, word.Id })', '@Localizer["EditWord"]')" class="icon-btn edit-btn" title="@Localizer["Edit"]">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="icon-btn delete-btn deleteWord" data-id="@word.Id" title="@Localizer["Delete"]">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    }
    <button id="scrollToBottomBtn" title="@Localizer["Scroll"]">
        <i class="bi bi-arrow-down-short"></i>
    </button>
</div>

@section Scripts {
    @*Scroll to the bottom button*@
    <script type="text/javascript">
        const scrollBtn = document.getElementById("scrollToBottomBtn");

        window.addEventListener("scroll", () => {
            if (window.scrollY > 100) {
                scrollBtn.classList.add("show");
            } else {
                scrollBtn.classList.remove("show");
            }
        });

        scrollBtn.addEventListener("click", () => {
            window.scrollTo({
                top: document.body.scrollHeight,
                behavior: "smooth"
            });
        });
    </script>

    @* Image Zoom *@
    <script type="text/javascript">
        const isMobile = window.innerWidth < 768;

        mediumZoom('.zoom-img', {
            margin: isMobile ? 5 : 50,
            background: "rgba(0, 0, 0, 0.7)"
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function() {

            const logoutUrl = "/Account/Account/Login";

            // Some data (fethed from server-side model)
            var count = @Model.Words.Count;
            var countFav = @Model.Words.Where(w => w.IsFavorite == true).Count();
            var setId = @Model.Id;

            $("#BtnStudy").prop("disabled", count === 0);
            $("#BtnStudyFav").prop("disabled", countFav === 0);

            $(".deleteWord").on("click", function () {
                var id = $(this).data("id");
                var card = $(this).closest(".quizlet-card");

                bootbox.confirm("@Localizer["BootBoxDeleteWord"]", function(result) {
                    if(result){
                        $.ajax({
                            url: '@Url.Action("DeleteWord", "Home")',
                            type: "POST",
                            data: { id: id },
                            success: function(res) {
                                count -= 1;

                                $("#numWords").text(count);
                                $("#word").text(count === 1 ? "@Localizer["Word"]" : "@Localizer["Words"]");

                                toastr.success("@Localizer["ToastrDeleteWord"]");

                                card.css('background','tomato');
                                card.fadeOut(800, function(){
                                    $(this).remove();
                                });

                                $("#BtnStudy").prop("disabled", count === 0);
                                $("#BtnStudyFav").prop("disabled", countFav === 0);
                            },
                            error: function (xhr) {
                                if (xhr.status === 401) {
                                    // User was logged out — show warning and redirect
                                    toastr.warning("@Localizer["ToastrLogout"]");
                                    setTimeout(function (res) {
                                        window.location.href = logoutUrl;
                                    }, 2000);
                                } else {
                                    // Optional: handle other errors
                                    toastr.error("@Localizer["ToastrDeleteWordError"]");
                                }
                            }
                        });
                    }
                });
            });

            $("#deleteSet").on("click", function () {
                bootbox.confirm("@Localizer["BootBoxDeleteSet"]", function(result) {
                    if(result){

                        // Disable both "Study" buttons to prevent premature navigation
                        $("#BtnStudy").prop("disabled", true);
                        $("#BtnStudyFav").prop("disabled", true);

                        $.ajax({
                            url: '@Url.Action("DeleteSet", "Home")',
                            type: "POST",
                            data: { id: setId },
                            success: function(res) {
                                // Redirect to index after successful deletion
                                window.location.href = '@Url.Action("Index", "Home")';
                            },
                            error: function (xhr) {
                                // Re-enable buttons in case of error
                                $("#BtnStudy").prop("disabled", false);
                                $("#BtnStudyFav").prop("disabled", false);

                                if (xhr.status === 401) {
                                    // User was logged out — show warning and redirect
                                    toastr.warning("@Localizer["ToastrLogout"]");
                                    setTimeout(function (res) {
                                        window.location.href = logoutUrl;
                                    }, 2000);
                                } else {
                                    // General error handling
                                    toastr.error("@Localizer["ToastrDeleteSetError"]");
                                }
                            }
                        });
                    }
                });
            });

            $(".fav-btn-in-sel").on("click", function () {
                const button = $(this);
                const wordId = button.data("id");
                const setId = button.data("setid");

                $.ajax({
                    type: "POST",
                    url: "/Sets/Home/Favorite",
                    data: { id: wordId, setId: setId },
                    success: function (res) {
                        button.toggleClass("favorited", res.isFavorite);

                        const countSpan = document.getElementById("FavCount");
                        const wordLabelSpan = document.getElementById("FavWordLabel");

                        if (countSpan && wordLabelSpan) {
                            let currentCount = parseInt(countSpan.innerText);
                            currentCount += res.isFavorite ? 1 : -1;
                            countSpan.innerText = currentCount;

                            // Обновление подписи: Word или Words
                            const label = currentCount === 1 ? "@Localizer["Word"]" : "@Localizer["Words"]";
                            wordLabelSpan.innerText = label;
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 401) handleSessionExpired();
                    }
                });
            });
        });
    </script>
}