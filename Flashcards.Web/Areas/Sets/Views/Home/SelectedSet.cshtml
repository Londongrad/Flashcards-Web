@model SetViewModel

<input hidden asp-for="Id" />

<p class="text-large text-light text-center my-5">
    Name of the set is @Model.Name. This set has in total <strong id="numWords">@Model.Words?.Count</strong> @(Model.Words?.Count == 1 ? "word" : "words")
    <a onclick="showInPopup('@Url.Action("AddOrEditSet", "Home", new { Model.Id }, Context.Request.Scheme)', 'Edit set')" class="btn sound-fav-btn" title="Edit name of the set">
        <i class="bi bi-pencil-square"></i>
    </a>
</p>

<div>
    <div class="float-start">
        <a asp-area="Sets" asp-controller="Home" asp-action="Index" type="button" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
            <i class="bi bi-arrow-down-left-circle"></i> Back
        </a>
    </div>

    <div class="float-start">
        <a id="BtnStudy" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
            <i class="bi bi-yin-yang"></i> Study this set
        </a>
    </div>

    <div class="float-start">
        <button id="BtnStudyFav" type="button" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
            <i class="bi bi-yin-yang"></i> Study only favorite [@Model.Words?.Where(w => w.IsFavorite == true).Count() words]
        </button>
    </div>

    <form asp-area="Sets" asp-controller="Home" asp-action="DeleteSet" asp-route-id="@Model.Id" method="post"
          onclick="return confirm('Are you sure you want to delete this set?')">
        <div class="float-end">
            <button title="Delete set" type="submit" class="btn btn-danger border-1 border-dark-subtle">
                <i class="bi bi-trash3"></i> Delete set
            </button>
        </div>
    </form>

    <div class="float-end">
        <a onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { setId = Model.Id }, Context.Request.Scheme)', 'Add new word')" title="Create new word" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
            <i class="bi bi-plus-lg"></i> Add new word
        </a>
    </div>
</div>

<table class="table table-bordered table-striped" cellpadding="0">
    <thead>
        <tr class="text-center">
            <th>Word</th>
            <th>Definition</th>
            <th>Image</th>
            <th></th>
        </tr>
    </thead>

    <tbody class="table-group-divider">
        @foreach (var word in Model.Words!)
        {
            <tr class="table-align" id="tableRow-@word.Id">
                <td hidden>@word.Id</td>
                <td class="table-data" style="width:18%">@word.Name</td>
                <td class="table-data">@word.Definition</td>
                <td style="width:18%">
                    @if (!string.IsNullOrEmpty(@word.ImagePath))
                    {
                        <img src="@word.ImagePath" class="zoom-img" asp-append-version="true" />
                    }
                    else
                    {
                        <p>No image</p>
                    }
                </td>
                <td style="width:10%">
                    <div class="btn-group-vertical" role="group">
                        <a onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { word.SetId, word.Id }, Context.Request.Scheme)', 'Edit word')" class="btn border-black border-1 text-bg-info p-2 text-center text-nowrap">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>

                        <button id="delete" class="btn border-black border-1 text-bg-dark p-2 text-center text-nowrap delete">
                            <i class="bi bi-trash-fill"></i> Delete
                        </button>
                    </div>

                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script type="text/javascript">
        mediumZoom('.zoom-img', {
            margin: 50,
            background: "transparent"
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function() {

            var count = @Model.Words.Count;
            var countFav = @Model.Words.Where(w => w.IsFavorite == true).Count();

            $(".delete").on("click", function () {

                var parent = $(this).parents("tr");
                var id = parent.find("td:eq(0)").text();

                $.ajax({
                    url: '@Url.Action("DeleteWord", "Home")',
                    type: "POST",
                    data: { id: id },
                    success: function(res) {
                        count -= 1;

                        $("#numWords").text(count);

                        $("#tableRow-" + id).remove();

                        $("#BtnStudy").prop("disabled", count === 0);
                        $("#BtnStudyFav").prop("disabled", countFav === 0);
                    }
                });
            });
        });
    </script>
}