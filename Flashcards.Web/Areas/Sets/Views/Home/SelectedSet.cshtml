@model SetViewModel

<input hidden asp-for="Id" />

<h2 class="text-light text-center my-5">
    Name of the set is @Model.Name. This set has in total @Model.Words?.Count @(Model.Words?.Count == 1 ? "word" : "words")
    <a class="btn sound-fav-btn" title="Edit" data-bs-toggle="modal" data-bs-target="#set">
        <i class="bi bi-pencil-square"></i>
    </a>
</h2>

<!-- Modal for edit set action -->
<form asp-area="Sets" asp-controller="Home" asp-action="EditSet" method="post">

    <input hidden asp-for="UserId" />
    <input hidden asp-for="Id" />

    <div class="modal fade" id="set" tabindex="-1" aria-labelledby="lableIMG" aria-hidden="true" data-bs-theme="dark">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-light" id="lableIMG">New set</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="input-group row m-0 p-0">
                        <label asp-for="@Model.Name" class="input-group-text bg-dark text-light"></label>
                        <input asp-for="@Model.Name" class="form-control bg-dark text-light">
                        <span asp-validation-for="@Model.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>

                    <button type="submit" class="btn btn-primary">
                        Update set
                    </button>

                </div>
            </div>
        </div>
    </div>
</form>

<div>

    <div class="float-start">
        <a asp-area="Sets" asp-controller="Home" asp-action="Index" type="button" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
            <i class="bi bi-arrow-down-left-circle"></i> Back
        </a>
    </div>

    <div class="float-start">
        <a asp-area="Sets" asp-controller="Home" asp-action="StudySelectedSet" asp-route-id="@Model.Id" id="studyBtn" type="button" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
            <i class="bi bi-yin-yang"></i> Study this set
        </a>
    </div>

    <form asp-area="Sets" asp-controller="Home" asp-action="DeleteSet" asp-route-id="@Model.Id" method="post"
          onclick="return confirm('Are you sure you want to delete this set?')">
        <div class="float-end">
            <button title="Delete set" type="submit" class="btn btn-danger border-1 border-dark-subtle">
                <i class="bi bi-trash3"></i> Delete set
            </button>
        </div>
    </form>

    <div class="float-end">
        <a onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { setId = Model.Id }, Context.Request.Scheme)', 'Add new word')" title="Create new word" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
            <i class="bi bi-plus-lg"></i> Add new word
        </a>
    </div>

    <!-- Modal for add new word action -->
    <form asp-area="Sets" asp-controller="Home" asp-action="AddWord" method="post">

        <input hidden asp-for="UserId" />
        <input hidden asp-for="Id" />

        <div class="modal fade" id="set" tabindex="-1" aria-labelledby="lableIMG" aria-hidden="true" data-bs-theme="dark">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-light" id="lableIMG">New set</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="input-group row m-0 p-0">
                            <label asp-for="@Model.Name" class="input-group-text bg-dark text-light"></label>
                            <input asp-for="@Model.Name" class="form-control bg-dark text-light">
                            <span asp-validation-for="@Model.Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>

                        <button type="submit" class="btn btn-primary">
                            Update set
                        </button>

                    </div>
                </div>
            </div>
        </div>
    </form>

</div>

<table class="table table-bordered table-striped" cellpadding="0">
    <thead>
        <tr class="text-center">
            <th>Word</th>
            <th>Definition</th>
            <th>Image</th>
            <th></th>
        </tr>
    </thead>

    <tbody class="table-group-divider">
        @foreach (var word in Model.Words!)
        {
            <tr class="table-align">
                <td class="table-data" style="width:18%">@word.Name</td>
                <td class="table-data">@word.Definition</td>
                <td style="width:18%">
                    @(!string.IsNullOrEmpty(@word.ImagePath)) ? <img src="@word.ImagePath" class="zoom-img" asp-append-version="true" /> : <p>No image</p>
                </td>
                <td style="width:10%">
                    <div class="btn-group-vertical" role="group">
                        <a onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { word.SetId, word.Id }, Context.Request.Scheme)', 'Edit word')" class="btn border-black border-1 text-bg-info p-2 text-center text-nowrap">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>

                        <form asp-area="Sets" asp-controller="Home" asp-action="DeleteWord" asp-route-wordid="@word.Id" asp-route-setid="@word.SetId" method="post"
                              onclick="return confirm('Are you sure you want to delete this word?')">
                            <button type="submit" class="btn border-black border-1 text-bg-dark p-2 text-center text-nowrap">
                                <i class="bi bi-trash-fill"></i> Delete
                            </button>
                        </form>

                    </div>

                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script type="text/javascript">
        const Btn = document.getElementById('studyBtn');
        if (@Model.Words?.Count === 0) {
            Btn.style.pointerEvents="none";
            Btn.style.cursor="default";
        }
        else {
            Btn.style.pointerEvents="auto";
            Btn.style.cursor="pointer";
        }
    </script>

    <script type="text/javascript">
        mediumZoom('.zoom-img', {
            margin: 50,
            background: "transparent"
        });
    </script>
}