@model SetViewModel

<input hidden asp-for="Id" />

<p class="text-large text-light text-center my-5">
    Name of the set is <strong id="setName">@Model.Name</strong>. This set has in total <strong id="numWords">@Model.Words?.Count</strong> <strong id="word">@(Model.Words?.Count == 1 ? "word" : "words")</strong>
    <a onclick="showInPopup('@Url.Action("AddOrEditSet", "Home", new { Model.Id })', 'Edit set')" class="btn sound-fav-btn" title="Edit name of the set">
        <i class="bi bi-pencil-square"></i>
    </a>
</p>

<div class="justify-content-center align-items-center text-center">
    <div class="row text-center align-items-end m-0">
        <div class="col-2 m-0 p-0 text-start">
            <a asp-area="Sets" asp-controller="Home" asp-action="Index" type="button" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
                <i class="bi bi-arrow-down-left-circle"></i> Back
            </a>
        </div>

        <div class="col-8 d-flex justify-content-center align-items-center text-center p-0">
            <button onclick="location.href='@Url.Action("StudySelectedSet", "Home", new { Model.Id, flag = false })'" id="BtnStudy" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
                <i class="bi bi-yin-yang"></i> Study this set
            </button>

            <button onclick="location.href='@Url.Action("StudySelectedSet", "Home", new { id = Model.Id, flag = true })'" id="BtnStudyFav" type="button" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
                <i class="bi bi-yin-yang"></i> Study only favorite [@Model.Words?.Where(w => w.IsFavorite == true).Count() words]
            </button>

            <a onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { setId = Model.Id })', 'Add new word')" title="Create new word" class="btn btn-primary border-1 border-dark-subtle text-bg-dark">
                <i class="bi bi-plus-lg"></i> Add new word
            </a>
        </div>

        <div class="col-2 m-0 p-0 text-end">
            <button id="deleteSet" title="Delete set" class="btn btn-danger border-1 border-dark-subtle">
                <i class="bi bi-trash3"></i> Delete set
            </button>
        </div>
    </div>

    <table class="table table-bordered table-striped" cellpadding="0">
        <thead>
            <tr class="text-center">
                <th>Word</th>
                <th>Definition</th>
                <th>Image</th>
                <th></th>
            </tr>
        </thead>

        <tbody class="table-group-divider">
            @foreach (var word in Model.Words!)
            {
                <tr class="table-align" id="tableRow-@word.Id">
                    <td class="table-data" style="width:18%">@word.Name</td>
                    <td class="table-data">@word.Definition</td>
                    <td style="width:18%">
                        @if (!string.IsNullOrEmpty(@word.ImagePath))
                        {
                            <img src="@word.ImagePath" class="zoom-img" asp-append-version="true" />
                        }
                        else
                        {
                            <p>No image</p>
                        }
                    </td>
                    <td style="width:10%">
                        <div class="btn-group-vertical" role="group">
                            <a onclick="showInPopup('@Url.Action("AddOrEditWord", "Home", new { word.SetId, word.Id })', 'Edit word')" class="btn border-black border-1 text-bg-info p-2 text-center text-nowrap">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>

                            <button data-id="@word.Id" class="btn border-black border-1 text-bg-dark p-2 text-center text-nowrap deleteWord">
                                <i class="bi bi-trash-fill"></i> Delete
                            </button>
                        </div>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script type="text/javascript">
        mediumZoom('.zoom-img', {
            margin: 50,
            background: "transparent"
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function() {

            var count = @Model.Words.Count;
            var countFav = @Model.Words.Where(w => w.IsFavorite == true).Count();
            var setId = @Model.Id;

            $("#BtnStudy").prop("disabled", count === 0);
            $("#BtnStudyFav").prop("disabled", countFav === 0);

            $(".deleteWord").on("click", function () {
                var id = $(this).data("id");
                bootbox.confirm("Do you really wanna delete this word?", function(result) {
                    if(result){
                        $.ajax({
                            url: '@Url.Action("DeleteWord", "Home")',
                            type: "POST",
                            data: { id: id },
                            success: function(res) {
                                count -= 1;

                                $("#numWords").text(count);
                                $("#word").text(count === 1 ? "word" : "words");

                                toastr.success("The word has been successfully deleted");

                                $("#tableRow-" + id).css('background','tomato');
                                $("#tableRow-" + id).fadeOut(800, function(){
                                    $(this).remove();
                                });

                                $("#BtnStudy").prop("disabled", count === 0);
                                $("#BtnStudyFav").prop("disabled", countFav === 0);
                            }
                        });
                    }
                });
            });

            $("#deleteSet").on("click", function () {
                bootbox.confirm("Do you really wanna delete this set?", function(result) {
                    if(result){
                        $.ajax({
                            url: '@Url.Action("DeleteSet", "Home")',
                            type: "POST",
                            data: { id: setId },
                            success: function(res) {
                                window.location.href = '@Url.Action("Index", "Home")';
                            }
                        });
                    }
                });
            });
        });
    </script>
}