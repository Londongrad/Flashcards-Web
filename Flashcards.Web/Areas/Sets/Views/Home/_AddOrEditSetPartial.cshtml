@model SetViewModel

@{
    Layout = null;
}

<form id="form-set" asp-area="Sets" asp-controller="Home" asp-action="AddOrEditSet" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="OldName" hidden />
    <input asp-for="UserId" hidden />
    <input asp-for="Id" hidden />

    <div class="modal-form-container">

        <div class="mb-3 text-center">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control">
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-5 m-auto">
                <button type="submit" class="m-auto btn btn-primary form-control border-black border-1 text-white">@(Model.Id == 0 ? SharedLocalizer["CreateSet"] : SharedLocalizer["UpdateSet"])</button>
            </div>
        </div>
    </div>
</form>

<script>
    $(function() {
        $("#form-set").submit(function(e) {
            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: form.attr("action"),
                type: form.attr("method"),
                data: form.serialize(),
                success: function(res) {
                    if (res.success) {
                        $("#form-modal").modal('hide');
                        if(res.isNew){
                            location.reload();
                        } else{
                            $("#setName").text(res.name);
                            toastr.success("The name of the set has been successfully updated");
                        }
                    } else {
                        $("#form-modal .modal-body").html(res);
                        $.validator.unobtrusive.parse(document);
                    }
                }
            });
        });
    });
</script>
