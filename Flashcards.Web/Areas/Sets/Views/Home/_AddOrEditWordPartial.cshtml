@model WordViewModel

@{
    Layout = null;
}

<form id="form-word" asp-area="Sets" asp-controller="Home" asp-action="AddOrEditWord" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input hidden asp-for="SetId" />
    <input hidden asp-for="Id" />

    <div class="modal-form-container">

        <div class="mb-3 text-center">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control">
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3 text-center">
            <label asp-for="Definition" class="form-label"></label>
            <input asp-for="Definition" class="form-control">
            <span asp-validation-for="Definition" class="text-danger small"></span>
        </div>

        <div class="mb-3 text-center">
            <label asp-for="ImagePath" class="form-label"></label>
            <input asp-for="ImagePath" class="form-control">
        </div>

        <div class="row">
            <div class="col-6 m-auto">
                <button type="submit" class="m-auto btn btn-primary form-control border-black border-1 text-white">@(Model.Id == 0 ? "Add word" : "Update word")</button>
            </div>
        </div>
    </div>
</form>

<script>
    $(function() {
        $("#form-word").submit(function(e) {
            e.preventDefault();

            var form = $(this);
            popupPost(form);
        });
    });
</script>