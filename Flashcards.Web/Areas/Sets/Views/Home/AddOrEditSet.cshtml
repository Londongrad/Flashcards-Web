@model SetViewModel

<form asp-area="Sets" asp-controller="Home" asp-action="AddOrEditSet" method="post">

    <input asp-for="UserId" hidden />
    <input asp-for="Id" hidden />

    <div class="border p-3 mt-4">

        <div class="row pb-2">
            @if (Model.Id == 0)
            {
                <h2 class="text-light text-center">Create new set</h2>
            }
            else
            {
                <h2 class="text-light text-center">Edit set</h2>
            }
            <hr />
        </div>

        <div class="input-group mb-3 row">
            <label asp-for="Name" class="input-group-text"></label>
            <input asp-for="Name" class="form-control">
            <span asp-validation-for="Name" class="text-danger mt-2"></span>
        </div>

        <div class="row">
            <div class="col-2 m-auto">
                @if (Model.Id == 0)
                {
                    <button type="submit" class="m-auto btn btn-primary form-control border-black border-1">Create set</button>
                }
                else
                {
                    <button type="submit" class="m-auto btn btn-primary form-control border-black border-1">Update set</button>
                }
                
            </div>

            <div class="col-2 m-auto">
                @if (Model.Id == 0)
                {
                    <a asp-area="Sets" asp-controller="Home" asp-action="Index" class="btn btn-secondary form-control border-black border-1">Back</a>
                }
                else
                {
                    <a asp-area="Sets" asp-controller="Home" asp-action="SelectedSet" asp-route-id="@Model.Id" class="btn btn-secondary form-control border-black border-1">Back</a>
                }
                
            </div>
        </div>
    </div>
</form>