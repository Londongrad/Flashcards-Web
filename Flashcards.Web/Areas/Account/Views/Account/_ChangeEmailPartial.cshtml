@model EmailViewModel

@{
    Layout = null;
}

<form id="formEmail" asp-area="Account" asp-controller="Account" asp-action="ChangeEmail" method="post">

    <div class="border p-3 mt-4">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="input-group row mb-3">
            <label asp-for="@Model.Email" class="input-group-text bg-dark text-light"></label>
            <input asp-for="@Model.Email" class="form-control bg-dark text-light">
            <span asp-validation-for="@Model.Email" class="text-danger mt-2"></span>
        </div>

        <div class="row">
            <div class="col-5 m-auto">
                <button type="submit" class="btn btn-primary">
                    Save changes
                </button>
            </div>
        </div>
    </div>
</form>

<script>
    $(function() {
        $("#formEmail").submit(function(e) {
            e.preventDefault();
            var form = $(this);
            popupPost(form);
        });
    });
</script>
