@model LoginViewModel;

@{
    string Title = Localizer["LoginPage"].Value;
    ViewBag.Title = Title;
}
<div class="account-container">
    <div class="account_box">

        <h2 class="text-center mb-4">@Title</h2>

        <form asp-area="Account" asp-controller="Account" asp-action="Login" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"> </span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"> </span>
            </div>

            <div class="float-end">
                <a asp-area="Account" asp-controller="Account" asp-action="VerifyEmail" class="text-decoration-none">
                    @Localizer["ForgotPassword"]
                </a>

            </div>

            <div class="form-check mb-3">
                <label class="form-check-label">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe"></label>
                </label>
            </div>

            <input type="submit" value="@Localizer["Login"]" class="btn btn-success w-100 p-2" />

            <p class="text-center mt-2">
                @Localizer["NoAccount"]<a asp-area="Account" asp-controller="Account" asp-action="Register" class="text-decoration-none">@Localizer["Register"]</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @if (Context.Request.Query["forcedLogout"] == "true")
    {
        <script>
            toastr.warning("@Localizer["KickedOut"]");
        </script>
    }
}