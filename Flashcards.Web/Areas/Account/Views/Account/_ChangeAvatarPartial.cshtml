@model ImageViewModel

@{
    Layout = null;
}

<form id="formEmail" asp-area="Account" asp-controller="Account" asp-action="UpdateAvatar" method="post">
    <div class="modal-form-container">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>


        <div class="mb-3 text-center">
            <label asp-for="@Model.ImageURL" class="form-label">Image URL</label>

            <div class="position-relative">
                <input asp-for="@Model.ImageURL"
                       class="form-control clearable-input pe-5"
                       autocomplete="off" />

                <button type="button" class="btn-clear" aria-label="Clear input">&times;</button>
            </div>

            <span asp-validation-for="@Model.ImageURL" class="text-danger small"></span>
        </div>


        <div class="text-center">
            <button type="submit" class="btn btn-submit">
                Save
            </button>
        </div>
    </div>
</form>

<script>
    $(function() {
        $("#formEmail").submit(function(e) {
            e.preventDefault();
            var form = $(this);
            popupPost(form);
        });
    });
</script>

<script>
        $('#modal-body').html(response); // response = HTML из PartialView
    setupClearableInputs(document.getElementById('modal-body'));
</script>