@model PasswordInSettingsViewModel

@{
    Layout = null;
}

<form id="formPassword" asp-area="Account" asp-controller="Account" asp-action="ChangePasswordInSettings" method="post">
    <div class="modal-form-container">

        <div class="mb-3 text-center">
            <label asp-for="@Model.OldPassword" class="form-label"></label>
            <input asp-for="@Model.OldPassword" class="form-control">
            <span asp-validation-for="@Model.OldPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3 text-center">
            <label asp-for="@Model.NewPassword" class="form-label"></label>
            <input asp-for="@Model.NewPassword" class="form-control">
            <span asp-validation-for="@Model.NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3 text-center">
            <label asp-for="@Model.ConfirmPassword" class="form-label"></label>
            <input asp-for="@Model.ConfirmPassword" class="form-control">
            <span asp-validation-for="@Model.ConfirmPassword" class="text-danger small"></span>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-submit">
                Save
            </button>
        </div>
    </div>
</form>

<script>
    $(function() {
        $("#formPassword").submit(function(e) {
            e.preventDefault();
            var form = $(this);
            popupPost(form);
        });
    });
</script>