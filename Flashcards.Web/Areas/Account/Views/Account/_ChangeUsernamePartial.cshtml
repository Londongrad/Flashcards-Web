@model UsernameViewModel

@{
    Layout = null;
}

<form id="formUsername" asp-area="Account" asp-controller="Account" asp-action="ChangeUsername" method="post">
    <div class="modal-form-container">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3 text-center">
            <label asp-for="@Model.Username" class="form-label"></label>
            <input asp-for="@Model.Username" class="form-control">
            <span asp-validation-for="@Model.Username" class="text-danger small"></span>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-submit">
                @SharedLocalizer["Save"]
            </button>
        </div>
    </div>
</form>

<script>
    $(function() {
        $("#formUsername").submit(function(e) {
            e.preventDefault();
            var form = $(this);
            popupPost(form);
        });
    });
</script>