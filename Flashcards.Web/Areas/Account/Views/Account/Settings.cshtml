@model ImageViewModel

@{
    string Title = "Settings";
    ViewBag.Title = Title;
    Layout = "_Layout";
}

<div class="container background-normal">
    <div class="container-fluid">
        <h1 class="text-light mt-5">@Title</h1>
        <hr class="border-bottom border-white" />

        <div class="settings-container">
            <div class="avatar-container me-2">
                @if (!string.IsNullOrEmpty(@Model.ImageURL))
                {
                    <img src="@Model.ImageURL" class="avatar-img" />
                }
                else
                {
                    <h6 class="avatar-img text-light text-center align-content-center">Currently no image</h6>
                }
            </div>

            <button onclick="showInPopup('@Url.Action("UpdateAvatar", "Account", new { Model.ImageURL }, Context.Request.Scheme)', 'Change avatar')" type="button" class="btn btn-primary m-2">
                <i class="bi bi-card-image"></i> Change avatar
            </button>

            <button onclick="showInPopup('@Url.Action("ChangePasswordInSettings", "Account", null, Context.Request.Scheme)', 'Change password')" type="button" class="btn btn-primary m-2">
                <i class="bi bi-arrow-repeat"></i> Change password
            </button>

            <button onclick="showInPopup('@Url.Action("ChangeEmail", "Account", null, Context.Request.Scheme)', 'Change email')" type="button" class="btn btn-primary m-2">
                <i class="bi bi-arrow-repeat"></i> Change email
            </button>

            <button onclick="showInPopup('@Url.Action("ChangeUsername", "Account", null, Context.Request.Scheme)', 'Change username')" class="btn btn-primary m-2">
                <i class="bi bi-arrow-repeat"></i> Change username
            </button>
        </div>

        <div class="d-inline-flex">
            <h1 class="text-light mt-5">Styling</h1>
            <p class="text-light align-content-center mt-5">(Yet to implement)</p>
        </div>
        <hr class="border-bottom border-white" />

        <div class="settings-container">
            <div class="dropdown m-2">
                <button class="btn btn-primary dropdown-toggle"
                        type="button" id="dropdownMenu1" data-bs-toggle="dropdown"
                        aria-haspopup="true" aria-expanded="false">
                    Theme
                </button>
                <div class="dropdown-menu dropdown-menu-dark text-center text-big" aria-labelledby="dropdownMenu1">
                    <a class="dropdown-item" href="#!">Dark</a>
                    <a class="dropdown-item" href="#!">Light</a>
                </div>
            </div>

            <div class="dropdown m-2">
                <button class="btn btn-primary dropdown-toggle"
                        type="button" id="dropdownMenu1" data-bs-toggle="dropdown"
                        aria-haspopup="true" aria-expanded="false">
                    Language
                </button>
                <div class="dropdown-menu dropdown-menu-dark text-center text-big" aria-labelledby="dropdownMenu1">
                    <a class="dropdown-item" href="#!">Russian</a>
                    <a class="dropdown-item" href="#!">English</a>
                </div>
            </div>
        </div>

        <h1 class="text-danger mt-5">Danger zone</h1>
        <hr class="border-bottom border-white" />

        <button onclick="showInPopup('@Url.Action("DeleteAccount", "Account", null, Context.Request.Scheme)', 'Delete account')" class="btn btn-danger border-1 border-dark-subtle">
            <i class="bi bi-x-octagon"></i> Delete account
        </button>
    </div>
</div>