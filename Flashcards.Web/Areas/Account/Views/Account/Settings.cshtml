@model ImageViewModel

@{
    string Title = Localizer["Settings"].Value;
    ViewBag.Title = Title;
    Layout = "_Layout";
}

<div class="background-normal px-3">
    <h1 class="text-light mt-5 responsive-title">@Title</h1>
    <hr class="border-bottom border-white mt-0" />

    <div class="settings-container">
        <div class="avatar-wrapper text-center">
            @if (!string.IsNullOrEmpty(@Model.ImageURL))
            {
                <div class="avatar-container mx-auto">
                    <img src="@Model.ImageURL" class="user-link-photo zoom-img-set" />
                </div>
            }
            else
            {
                <div class="avatar-container mx-auto text-center align-content-center mb-0">
                    <h6 class="avatar-img text-light mb-0">@Localizer["NoImage"]</h6>
                </div>
            }
        </div>

        <button onclick="showInPopup('@Url.Action("UpdateAvatar", "Account", new { Model.ImageURL })', 'Change avatar')" type="button" class="btn btn-primary">
            <i class="bi bi-card-image"></i> @Localizer["ChangeAvatar"]
        </button>

        <button onclick="showInPopup('@Url.Action("ChangePasswordInSettings", "Account")', 'Change password')" type="button" class="btn btn-primary">
            <i class="bi bi-arrow-repeat"></i> @Localizer["ChangePassword"]
        </button>

        <button onclick="showInPopup('@Url.Action("ChangeEmail", "Account")', 'Change email')" type="button" class="btn btn-primary">
            <i class="bi bi-arrow-repeat"></i> @Localizer["ChangeEmail"]
        </button>

        <button onclick="showInPopup('@Url.Action("ChangeUsername", "Account")', 'Change username')" class="btn btn-primary">
            <i class="bi bi-arrow-repeat"></i> @Localizer["ChangeUsername"]
        </button>
    </div>

    <div class="d-inline-flex">
        <h1 class="text-light mt-5 text-center responsive-title">@Localizer["Styling"]</h1>
        <p class="text-light align-content-center mt-5">(@Localizer["YetToImplement"])</p>
    </div>
    <hr class="border-bottom border-white mt-0" />

    <div class="settings-container">
        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle"
                    type="button" id="dropdownMenu1" data-bs-toggle="dropdown"
                    aria-haspopup="true" aria-expanded="false">
                @Localizer["Theme"]
            </button>
            <div class="dropdown-menu dropdown-menu-dark text-center text-big theme-dropdown" aria-labelledby="dropdownMenu1">
                <a class="dropdown-item" href="#!">@Localizer["Dark"]</a>
                <a class="dropdown-item" href="#!">@Localizer["Light"]</a>
            </div>
        </div>

        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle"
                    type="button" id="dropdownMenu1" data-bs-toggle="dropdown"
                    aria-haspopup="true" aria-expanded="false">
                @Localizer["Language"]
            </button>
            <div class="dropdown-menu dropdown-menu-dark text-center text-big theme-dropdown" aria-labelledby="dropdownMenu1">
                <form asp-area="Account" asp-controller="Account" asp-action="ChangeLanguage" method="post">
                    <input type="hidden" name="lang" value="ru-RU">
                    <a class="dropdown-item" href="javascript:void(0);" onclick="this.closest('form').submit();">Русский</a>
                </form>
                <form asp-area="Account" asp-controller="Account" asp-action="ChangeLanguage" method="post">
                    <input type="hidden" name="lang" value="en-US">
                    <a class="dropdown-item" href="javascript:void(0);" onclick="this.closest('form').submit();">English</a>
                </form>
            </div>
        </div>
    </div>

    <h1 class="text-danger mt-5 responsive-title">@Localizer["DangerZone"]</h1>
    <hr class="border-bottom border-white mt-0" />

    <div class="settings-container mb-4">
        <button onclick="showInPopup('@Url.Action("DeleteAccount", "Account")', 'Delete account')" class="btn btn-danger border-1 border-dark-subtle text-center">
            <i class="bi bi-x-octagon"></i> @Localizer["DeleteAccount"]
        </button>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        const isMobile = window.innerWidth < 768;

        mediumZoom('.zoom-img-set', {
            margin: isMobile ? 5 : 50,
            background: "transparent"
        });
    </script>
}