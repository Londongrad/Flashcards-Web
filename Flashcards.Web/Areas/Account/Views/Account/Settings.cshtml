@model UserViewModel

@{
    string Title = "Settings";
    ViewBag.Title = Title;
    Layout = "_Layout";
}

<div class="container background-normal">
    <div class="container-fluid">
        <h1 class="text-light mt-5">@Title</h1>
        <hr class="border-bottom border-white" />

        <div class="settings-container">
            <div class="avatar-container me-2">
                @if (!string.IsNullOrEmpty(@Model.ImageURL))
                {
                    <img src="@Model.ImageURL" class="avatar-img" />
                }
                else
                {
                    <h6 class="avatar-img text-light text-center align-content-center">Currently no image</h6>
                }
            </div>

            <button type="button" class="btn btn-primary m-2" data-bs-toggle="modal" data-bs-target="#img">
                <i class="bi bi-card-image"></i> Change avatar
            </button>

            <form asp-area="Account" asp-controller="Account" asp-action="UpdateAvatar" method="post">
                <!-- Modal -->
                <div class="modal fade" id="img" tabindex="-1" aria-labelledby="lableIMG" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="lableIMG">AVATAR</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="input-group row">
                                    <label asp-for="@Model.ImageURL" class="input-group-text"></label>
                                    <input asp-for="@Model.ImageURL" class="form-control">
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

                                <button type="submit" class="btn btn-primary">
                                    Save changes
                                </button>

                            </div>
                        </div>
                    </div>
                </div>
            </form>

            <a asp-area="" asp-controller="" asp-action="" class="btn btn-primary m-2">
                <i class="bi bi-arrow-repeat"></i> Change password
            </a>
            <a asp-area="" asp-controller="" asp-action="" class="btn btn-primary m-2">
                <i class="bi bi-arrow-repeat"></i> Change email
            </a>
        </div>

        <h1 class="text-danger mt-5">Danger zone</h1>
        <hr class="border-bottom border-white" />

        <form asp-area="Account" asp-controller="Account" asp-action="DeleteAccount" method="post"
              onclick="return confirm('Are you sure you want to delete this account?')">
            <button title="Delete account" type="submit" class="btn btn-danger border-1 border-dark-subtle">
                <i class="bi bi-x-octagon"></i> Delete account
            </button>

        </form>
    </div>
</div>